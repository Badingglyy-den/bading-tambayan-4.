
@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap');

:root {
  --bg: #111027;
  --bg2: #191638;
  --panel: #211d43;
  --panel2: #2a2451;
  --purple: #a77bff;
  --lavender: #d0b6ff;
  --pink: #ffadd8;
  --white: #fffaff;
  --muted: #bcb3d7;
  --border: rgba(207,183,255,.18);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html { scroll-behavior: smooth; }

body {
  min-height: 100vh;
  font-family: 'Nunito', sans-serif;
  color: var(--white);
  background:
    radial-gradient(ellipse at 15% 10%, #302052 0%, transparent 38%),
    radial-gradient(ellipse at 90% 75%, #211c48 0%, transparent 40%),
    var(--bg);
  overflow-x: hidden;
}

button { font: inherit; cursor: pointer; }

.star-layer {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  overflow: hidden;
}

.star {
  position: absolute;
  color: #d9c4ff;
  opacity: .6;
  animation: twinkle 3s infinite ease-in-out alternate;
}

@keyframes twinkle {
  from { opacity: .15; transform: scale(.7); }
  to { opacity: .8; transform: scale(1.2); }
}

.hidden { display: none !important; }

.topbar {
  width: 100%;
  min-height: 72px;
  padding: 14px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-bottom: 1px solid var(--border);
  background: rgba(17,16,39,.8);
  backdrop-filter: blur(15px);
  position: sticky;
  top: 0;
  z-index: 20;
}

.brand {
  color: var(--white);
  text-decoration: none;
  font-size: 16px;
  font-weight: 900;
  letter-spacing: 1px;
}

.brand-icon { color: var(--lavender); font-size: 22px; }
.brand b { color: var(--lavender); }
.brand small { color: var(--pink); font-size: 11px; }

.topbar nav {
  display: flex;
  gap: 10px;
}

.topbar nav button,
.menu-button {
  border: 0;
  background: transparent;
  color: var(--muted);
  padding: 9px 13px;
  border-radius: 10px;
}

.topbar nav button:hover {
  background: var(--panel);
  color: white;
}

.menu-button { display: none; font-size: 22px; }

main {
  width: min(1120px, 90%);
  margin: auto;
  min-height: 75vh;
}

.welcome-screen {
  min-height: 83vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 50px 15px;
}

.welcome-orb {
  width: 110px;
  height: 110px;
  display: grid;
  place-items: center;
  font-size: 55px;
  border-radius: 50%;
  background: linear-gradient(145deg,#44316c,#211b48);
  box-shadow: 0 0 60px #9866ff44;
  animation: float 4s ease-in-out infinite;
  margin-bottom: 30px;
}

@keyframes float {
  50% { transform: translateY(-12px); }
}

.eyebrow {
  color: var(--pink);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 2.2px;
  margin-bottom: 12px;
}

h1 {
  font-size: clamp(34px,6vw,64px);
  line-height: 1.12;
  font-weight: 900;
}

h1 span { color: var(--lavender); }

.welcome-copy {
  color: var(--muted);
  margin: 20px 0 28px;
  line-height: 1.8;
}

.primary-button {
  border: 0;
  border-radius: 14px;
  padding: 15px 28px;
  color: #211637;
  font-weight: 900;
  background: linear-gradient(110deg,#d6baff,#ffaedb);
  box-shadow: 0 8px 30px #b47bff38;
  transition: .25s;
}

.primary-button:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 35px #b47bff65;
}

.primary-button span { margin-left: 8px; }

.welcome-foot {
  color: var(--muted);
  font-size: 12px;
  margin-top: 22px;
}

.page { display: none; padding: 38px 0 70px; }
.page.active { display: block; }

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 42px 0 30px;
}

.hero-copy { max-width: 650px; }
.hero h1 { font-size: clamp(38px,6vw,58px); }
.hero-copy > p:last-child { color: var(--muted); margin-top: 15px; }

.hero-moon {
  font-size: clamp(65px,12vw,115px);
  filter: drop-shadow(0 0 25px #a87bff77);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 14px;
  margin: 15px 0 55px;
}

.stat-card {
  background: linear-gradient(145deg,var(--panel),#1c1938);
  border: 1px solid var(--border);
  border-radius: 17px;
  padding: 17px;
  display: flex;
  align-items: center;
  gap: 13px;
}

.stat-card > span { font-size: 28px; }
.stat-card strong { display: block; font-size: 23px; }
.stat-card small { display: block; color: var(--muted); font-size: 11px; }

.dashboard-section { margin-bottom: 50px; }

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22px;
}

.section-heading h2 { font-size: 28px; }
.heading-star { color: var(--lavender); font-size: 35px; }

.world-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 17px;
}

.world-card {
  position: relative;
  overflow: hidden;
  text-align: left;
  min-height: 225px;
  padding: 22px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  border: 1px solid var(--border);
  border-radius: 19px;
  color: var(--white);
  background: linear-gradient(145deg,#29234c,#1b1937);
  transition: transform .25s, border-color .25s, box-shadow .25s;
}

.world-card::after {
  content: '';
  position: absolute;
  width: 130px;
  height: 130px;
  right: -45px;
  top: -45px;
  border-radius: 50%;
  background: var(--glow,#a77bff);
  opacity: .13;
  filter: blur(5px);
}

.world-card:hover {
  transform: translateY(-6px);
  border-color: var(--lavender);
  box-shadow: 0 12px 35px #0004;
}

.world-emoji { font-size: 38px; margin-bottom: 13px; }
.world-number { color: var(--pink); font-size: 9px; font-weight: 900; letter-spacing: 2px; }
.world-card strong { font-size: 18px; margin: 5px 0; }
.world-card small { color: var(--muted); line-height: 1.5; }
.world-enter { color: var(--lavender); font-size: 10px; font-weight: 900; margin-top: auto; padding-top: 18px; }

.arcade { --glow: #a77bff; }
.comfort { --glow: #ffadd8; }
.lab { --glow: #7bdcca; }
.mystery { --glow: #8c8dff; }
.confession { --glow: #e9a7d5; }
.community { --glow: #ffd27d; }

.feature-strip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 27px;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: linear-gradient(110deg,#30234f,#251c43);
}

.feature-strip h2 { color: var(--lavender); margin-bottom: 7px; }
.feature-strip p:not(.eyebrow) { color: var(--muted); margin-bottom: 8px; }
.feature-strip strong { color: var(--pink); }
.feature-emoji { font-size: 55px; }

.back-button {
  border: 1px solid var(--border);
  color: var(--lavender);
  background: var(--panel);
  border-radius: 11px;
  padding: 10px 15px;
  margin-bottom: 28px;
}

.world-hero {
  text-align: center;
  padding: 35px 15px;
  background: linear-gradient(145deg,#29214a,#191631);
  border: 1px solid var(--border);
  border-radius: 22px;
}

.large-emoji { font-size: 60px; display: block; margin-bottom: 15px; }
.world-hero h1 { font-size: clamp(32px,5vw,48px); }
.world-hero > p:last-child { color: var(--muted); margin-top: 12px; }

.coming-soon {
  margin-top: 22px;
  padding: 45px 20px;
  text-align: center;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
}

.coming-soon > span { font-size: 42px; }
.coming-soon h2 { margin: 12px 0; }
.coming-soon p, .coming-soon small { color: var(--muted); }
.coming-soon small { display: block; margin-top: 12px; }

.page-intro { color: var(--muted); margin: 10px 0 25px; }

.collection-panel, .settings-panel {
  padding: 25px;
  margin: 22px 0 35px;
  border: 1px solid var(--border);
  border-radius: 19px;
  background: var(--panel);
}

.collection-number {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.collection-number span { font-size: 35px; }
.collection-number strong { font-size: 35px; }
.collection-number small { color: var(--muted); }

.progress-track {
  height: 10px;
  margin: 20px 0 12px;
  background: #131127;
  border-radius: 20px;
  overflow: hidden;
}

#starProgress {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg,#a77bff,#ffadd8);
  border-radius: inherit;
  transition: width .4s;
}

#collectionMessage, #discoverySummary { color: var(--muted); }

#collectionPage h2 { margin: 30px 0 15px; }

.achievement-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 12px;
}

.achievement-card {
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--panel);
  display: flex;
  gap: 12px;
  align-items: center;
}

.achievement-card span { font-size: 30px; }
.achievement-card strong { display: block; }
.achievement-card small { color: var(--muted); }

.achievement-card.locked { opacity: .45; }

.settings-panel p, .settings-panel small { color: var(--muted); display: block; margin: 10px 0 18px; }

.secondary-button, .danger-button {
  display: block;
  width: 100%;
  padding: 12px;
  border-radius: 11px;
  margin-top: 12px;
  font-weight: 800;
}

.secondary-button {
  color: var(--lavender);
  background: #352858;
  border: 1px solid var(--border);
}

.danger-button {
  color: #ffc1d3;
  background: #48243d;
  border: 1px solid #874b70;
}

footer {
  border-top: 1px solid var(--border);
  padding: 28px 15px;
  text-align: center;
  color: var(--muted);
}

footer p { margin-bottom: 6px; }
footer small { font-size: 9px; letter-spacing: 2px; }

@media (max-width: 760px) {
  .topbar { padding: 13px 5%; }
  .menu-button { display: block; }
  .topbar nav {
    display: none;
    position: absolute;
    top: 65px;
    right: 5%;
    flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 13px;
    padding: 8px;
    min-width: 180px;
  }
  .topbar nav.open { display: flex; }
  .topbar nav button { text-align: left; }
  main { width: 90%; }
  .hero { padding-top: 30px; }
  .hero-moon { font-size: 65px; }
  .world-grid { grid-template-columns: repeat(2,1fr); gap: 11px; }
  .world-card { min-height: 215px; padding: 15px; }
  .world-card strong { font-size: 15px; }
  .world-card small { font-size: 11px; }
  .stats-grid { gap: 8px; }
  .stat-card { padding: 12px 8px; gap: 7px; }
  .stat-card > span { font-size: 21px; }
  .stat-card strong { font-size: 18px; }
  .stat-card small { font-size: 9px; }
}

@media (max-width: 390px) {
  .world-grid { grid-template-columns: 1fr; }
  .world-card { min-height: 190px; }
  .hero-moon { display: none; }
  .feature-strip { padding: 19px; }
  .feature-emoji { font-size: 38px; }
  .achievement-grid { grid-template-columns: 1fr; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}
